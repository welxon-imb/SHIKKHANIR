# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional - enables live Supabase PostgreSQL, Auth & Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session Signing Secret & Optional Admin Access Override (Server-side only)
SESSION_SECRET=
ADMIN_ACCESS_PASSWORD=

# Bangladesh Payment Gateway Credentials (Server-side only - leave empty for Integration Pending state)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
